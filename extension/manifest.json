{
  "manifest_version": 3,
  "name": "Bahnkarte24",
  "version": "0.3.0",
  "description": "Prüft mit deinen echten bahn.de-Fahrten, ob sich deine BahnCard gelohnt hat. Ein Klick, nichts verlässt deinen Browser.",
  "homepage_url": "https://bahnkarte24.de/",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Hat sich meine BahnCard gelohnt?",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.bahn.de/*"
      ],
      "js": [
        "core.js",
        "bahn.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://bahnkarte24.de/*",
        "https://www.bahnkarte24.de/*",
        "http://localhost:8765/*",
        "http://127.0.0.1:8765/*"
      ],
      "js": [
        "site.js"
      ],
      "run_at": "document_end"
    }
  ]
}
